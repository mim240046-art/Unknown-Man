{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unknownman:schema/config/v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "dayDurationMinutes",
    "ai",
    "anomalies",
    "survival",
    "performance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dayDurationMinutes": {
      "type": "number",
      "minimum": 20,
      "maximum": 180
    },
    "ai": {
      "type": "object",
      "required": [
        "fastHz",
        "mediumHz",
        "slowHz",
        "maxVisionDistance",
        "hearingMultiplier"
      ],
      "properties": {
        "fastHz": {
          "type": "number",
          "minimum": 5,
          "maximum": 10
        },
        "mediumHz": {
          "type": "number",
          "minimum": 2,
          "maximum": 4
        },
        "slowHz": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "maxVisionDistance": {
          "type": "number",
          "minimum": 8,
          "maximum": 96
        },
        "hearingMultiplier": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "anomalies": {
      "type": "object",
      "required": [
        "maxActive",
        "globalCooldownSeconds"
      ],
      "properties": {
        "maxActive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "globalCooldownSeconds": {
          "type": "number",
          "minimum": 5,
          "maximum": 600
        }
      },
      "additionalProperties": false
    },
    "survival": {
      "type": "object",
      "required": [
        "staminaDrainPerSecond",
        "sleepPressurePerMinute"
      ],
      "properties": {
        "staminaDrainPerSecond": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "sleepPressurePerMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "required": [
        "maxActiveMonsterEntities",
        "maxParticlesNear",
        "maxPositionalSounds"
      ],
      "properties": {
        "maxActiveMonsterEntities": {
          "const": 1
        },
        "maxParticlesNear": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "maxPositionalSounds": {
          "type": "integer",
          "minimum": 4,
          "maximum": 32
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
